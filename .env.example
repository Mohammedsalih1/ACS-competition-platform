# =============================================================================
# ACS Frontend - environment template
# Copy to .env.local and adjust per environment. Vite only exposes VITE_* vars.
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   bash:                cp .env.example .env.local
# =============================================================================

# Base URL of the backend API, including the API prefix.
# Must match the backend's PORT + API_PREFIX, and this app's own origin must be
# listed in the backend's CORS_ORIGINS (credentials are sent on every request).
VITE_API_URL=http://localhost:5000/api/v1
